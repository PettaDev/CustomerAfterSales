{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/screenshots/:path*",
      "destination": "https://raw.githubusercontent.com/PettaDev/CustomersGuide/d11db7bcbc0543e955b723ea326ee838b6118e13/public/screenshots/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "https://raw.githubusercontent.com/PettaDev/CustomersGuide/d11db7bcbc0543e955b723ea326ee838b6118e13/public/videos/:path*"
    },
    {
      "source": "/flags/:path*",
      "destination": "https://raw.githubusercontent.com/PettaDev/CustomersGuide/d11db7bcbc0543e955b723ea326ee838b6118e13/public/flags/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/ajuda",
      "destination": "/ajuda/index.html"
    },
    {
      "source": "/ajuda/",
      "destination": "/ajuda/index.html"
    },
    {
      "source": "/ajuda/:slug",
      "destination": "/ajuda/:slug/index.html"
    },
    {
      "source": "/ajuda/:slug/",
      "destination": "/ajuda/:slug/index.html"
    },
    {
      "source": "/pontos-de-apoio",
      "destination": "/pontos-de-apoio/index.html"
    },
    {
      "source": "/pontos-de-apoio/",
      "destination": "/pontos-de-apoio/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ]
}
