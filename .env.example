# Local: SQLite and private local evidence; production: PostgreSQL + S3-compatible storage
APP_ORIGIN=http://localhost:5173
PORT=3001
DATABASE_URL=
STAFF_EMAIL=
# Generate with npm run setup:staff. Never commit a password or this hash.
STAFF_PASSWORD_HASH=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=false
# Existing extracted, verified MobileQA RC3 directory on the customer's Windows PC
MOBILEQA_RUNTIME=C:/Tools/MobileQA_Tool_v1.0_RC3
# Optional assistant; no credentials are bundled
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
