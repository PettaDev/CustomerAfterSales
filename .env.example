# Local: SQLite and private local evidence; production: PostgreSQL + S3-compatible storage
APP_ORIGIN=http://localhost:5173
PORT=3001
DATABASE_URL=
# Multi-user team configuration. Run npm run setup:staff once for each person.
# Supported roles: tfae (operational) and manager (read-only monitoring).
# Normal staff access is passwordless; never commit corporate e-mails or secrets.
STAFF_USERS_JSON=
# Passwordless e-mail code delivery. AUTH_EMAIL_FROM must use a verified sender/domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=BRTE <no-reply@example.com>
# Keep false in normal production. Set true only for a deliberate temporary fallback.
AUTH_ALLOW_PASSWORD_FALLBACK=false
# Legacy single-user password fallback kept only for migration/backward compatibility.
STAFF_EMAIL=
STAFF_PASSWORD_HASH=
STAFF_ROLE=tfae
STAFF_ID=gustavo
STAFF_NAME=Gustavo
STAFF_MARKET=BR
STAFF_COUNTRY=Brasil
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=false
# Existing extracted, verified MobileQA RC3 directory on the customer's Windows PC
MOBILEQA_RUNTIME=C:/Tools/MobileQA_Tool_v1.0_RC3
# Optional assistant; no credentials are bundled
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
